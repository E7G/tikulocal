import { Button, LineEdit, ComboBox, CheckBox, StandardListView, GroupBox,
         TextEdit, ProgressIndicator, TabWidget, Palette, ListView } from "std-widgets.slint";

export struct FileRow { name: string, path: string }
export struct QuestionRow { id: int, title: string, options: string, kind: string, answer: string, date: string, selected: bool }

export component MainWindow inherits Window {
    title: "TikuLocal";
    width: 390px;
    height: 790px;
    background: Palette.background;
    private property <bool> is-dark: root.theme-mode == 2 || (root.theme-mode == 0 && root.system-dark);
    private property <brush> card: root.is-dark ? #27232c : #f7f2fa;
    private property <brush> outline: root.is-dark ? #49454f : #ded7e0;
    in-out property <int> page: 0;
    in-out property <string> query: "";
    in-out property <int> filter-index: 0;
    in-out property <int> selected-file-index: -1;
    in-out property <int> selected-manage-row: -1;
    in-out property <string> status: "准备就绪";
    in-out property <string> import-report: "暂无导入记录";
    in-out property <string> database-path: "";
    in-out property <string> service-state: "本地 API";
    in-out property <bool> import-busy: false;
    in-out property <bool> confirm-clear: false;
    in-out property <bool> confirm-delete: false;
    in-out property <int> theme-mode: 0;
    in-out property <bool> system-dark: false;
    in property <[FileRow]> staged-files;
    in property <[QuestionRow]> search-results;
    in property <[QuestionRow]> manage-rows;
    in property <[StandardListViewItem]> file-items;
    in property <[[StandardListViewItem]]> search-table-rows;
    in property <[[StandardListViewItem]]> manage-table-rows;
    in property <int> match-count: 0;
    in property <int> total: 0;
    in property <int> single-count: 0;
    in property <int> multiple-count: 0;
    in property <int> blank-count: 0;
    in property <int> judge-count: 0;
    in property <int> essay-count: 0;
    in property <int> selected-count: 0;
    callback choose-files();
    callback import-all();
    callback remove-staged(int);
    callback clear-staged();
    callback search(string,int);
    callback refresh();
    callback toggle-selected(int);
    callback delete-selected();
    callback clear-all();
    callback open-folder();
    callback export-json();
    callback theme-changed(int);
    public function apply-palette(mode:int) {
        Palette.color-scheme = mode == 2 ? ColorScheme.dark : (mode == 1 ? ColorScheme.light : ColorScheme.unknown);
    }

    VerticalLayout {
        padding: 12px; spacing: 8px;
        HorizontalLayout {
            height: 66px; spacing: 12px;
            Rectangle { width: 46px; height: 46px; border-radius: 14px; background: #6750a4;
                Text { text: "T"; color: white; font-weight: 800; font-size: 25px; horizontal-alignment: center; vertical-alignment: center; }
            }
            VerticalLayout {
                spacing: 3px;
                Text { text: "TikuLocal"; font-size: 23px; font-weight: 700; color: Palette.foreground; }
                Text { text: "离线题库工作台 · Material"; font-size: 11px; color: Palette.foreground; }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: root.total + " 道"; font-size: 14px; color: Palette.foreground; vertical-alignment: center; }
        }
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            if root.page == 0: VerticalLayout { spacing: 12px; padding-top: 8px;
                    Text { text: "导入答案"; font-size: 21px; font-weight: 700; color: Palette.foreground; }
                    Text { text: "从 Android 文件选择器挑选 .docx 或 .json，可一次导入多个。"; color: Palette.foreground; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; height: 52px;
                        Button { text: "选取文件"; primary: true; clicked => { root.choose-files(); } }
                        Button { text: "开始导入"; enabled: root.staged-files.length > 0 && !root.import-busy; clicked => { root.import-all(); } }
                        if root.import-busy: ProgressIndicator { width: 26px; height: 26px; indeterminate: true; }
                    }
                    Text { text: "已选文件 · " + root.staged-files.length; font-weight: 650; font-size: 14px; color: Palette.foreground; }
                    StandardListView {
                        model: root.file-items; current-item <=> root.selected-file-index;
                        vertical-stretch: 1;
                    }
                    HorizontalLayout { height: 45px; spacing: 8px;
                        Button { text: "移除选中"; enabled: root.selected-file-index >= 0 && !root.import-busy; clicked => { root.remove-staged(root.selected-file-index); root.selected-file-index=-1; } }
                        Button { text: "清空列表"; enabled: root.staged-files.length > 0 && !root.import-busy; clicked => { root.clear-staged(); } }
                    }
                    Text { text: "导入报告"; color: Palette.foreground; font-weight: 650; }
                    TextEdit { text: root.import-report; read-only: true; height: 95px; }
                }
            if root.page == 1: VerticalLayout { spacing: 10px; padding-top: 8px;
                    Text { text: "查找答案"; font-size: 21px; font-weight: 700; color: Palette.foreground; }
                    LineEdit { text <=> root.query; placeholder-text: "输入关键词"; accepted => { root.search(root.query,root.filter-index); } }
                    HorizontalLayout { spacing: 8px; height: 48px;
                        ComboBox { model: ["全部","单选","多选","填空","判断","问答"]; current-index <=> root.filter-index; horizontal-stretch: 1; }
                        Button { text: "搜索"; primary: true; clicked => { root.search(root.query,root.filter-index); } }
                    }
                    Text { text: "找到 " + root.match-count + " 道题"; color: Palette.foreground; font-size: 13px; }
                    ListView {
                        vertical-stretch: 1;
                        for row[i] in root.search-results: Rectangle {
                            height: 112px; border-width: 1px; border-color: root.outline;
                            border-radius: 14px; background: root.card;
                            VerticalLayout { padding: 10px; spacing: 6px;
                                Text { text: row.kind + " · " + row.title; color: Palette.foreground; font-size: 14px; font-weight: 700; overflow: elide; }
                                Text { text: row.options; color: Palette.foreground; font-size: 12px; overflow: elide; }
                                Text { text: "✓ " + row.answer; font-size: 15px; font-weight: 700; color: Palette.foreground; overflow: elide; }
                            }
                        }
                    }
                }
            if root.page == 2: VerticalLayout { spacing: 9px; padding-top: 8px;
                    Text { text: "题库管理"; font-size: 21px; font-weight: 700; color: Palette.foreground; }
                    Text { text: root.total + " 道题 · 单选 " + root.single-count + " · 多选 " + root.multiple-count; color: Palette.foreground; font-size: 12px; }
                    HorizontalLayout { height: 45px; spacing: 6px;
                        Button { text: "刷新"; clicked => { root.refresh(); } }
                        Button { text: "导出"; clicked => { root.export-json(); } }
                        Button { text: "删选中 (" + root.selected-count + ")"; enabled: root.selected-count > 0; clicked => { root.confirm-delete=true; } }
                    }
                    if root.confirm-delete: HorizontalLayout { height: 43px; spacing: 10px;
                        Text { text: "确定删除？"; color: Palette.foreground; }
                        Button { text: "确定"; clicked => { root.delete-selected();root.confirm-delete=false; } }
                        Button { text: "取消"; clicked => { root.confirm-delete=false; } }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row[i] in root.manage-rows: Rectangle {
                            height: 88px; background: root.card;
                            border-width: 1px; border-color: root.outline; border-radius: 14px;
                            HorizontalLayout { padding: 7px; spacing: 8px;
                                CheckBox { checked: row.selected; toggled => { root.toggle-selected(i); } }
                                VerticalLayout { horizontal-stretch: 1; spacing: 5px;
                                    Text { text: row.title; color: Palette.foreground; font-size: 14px; font-weight: 650; overflow: elide; }
                                    Text { text: row.kind + " · " + row.answer; color: Palette.foreground; font-size: 12px; overflow: elide; }
                                }
                            }
                        }
                    }
                }
            if root.page == 3: VerticalLayout { spacing: 15px; padding-top: 8px;
                    Text { text: "设置"; font-size: 21px; font-weight: 700; color: Palette.foreground; }
                    GroupBox { title: "外观";
                        VerticalLayout { spacing: 10px;
                            Text { text: "跟随系统、亮色或暗色"; color: Palette.foreground; }
                            ComboBox { model: ["跟随系统","亮色","暗色"]; current-index <=> root.theme-mode;
                                selected(value) => { root.apply-palette(root.theme-mode); root.theme-changed(root.theme-mode); }
                            }
                        }
                    }
                    GroupBox { title: "本地题库 API";
                        VerticalLayout { spacing: 8px;
                            Text { text: root.service-state; color: Palette.foreground; wrap: word-wrap; }
                            Text { text: "127.0.0.1:8060"; color: Palette.foreground; }
                        }
                    }
                    GroupBox { title: "离线数据库";
                        VerticalLayout { spacing: 8px;
                            Text { text: "保存在应用私有目录"; color: Palette.foreground; }
                            Button { text: "通过系统选择器导出题库"; clicked => { root.export-json(); } }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Button { text: "清空全部题库…"; clicked => { root.confirm-clear=true; } }
                    if root.confirm-clear: HorizontalLayout { height: 46px;
                        Button { text: "确认清空"; clicked => { root.clear-all();root.confirm-clear=false; } }
                        Button { text: "取消"; clicked => { root.confirm-clear=false; } }
                    }
                }
        }
        Text { text: root.status; height: 22px; font-size: 11px; color: Palette.foreground; overflow: elide; }
        Rectangle {
            height: 65px; background: root.card; border-radius: 18px;
            border-width: 1px; border-color: root.outline;
            HorizontalLayout {
                padding: 7px; spacing: 5px;
                Button { text: "↓ 导入"; primary: root.page == 0; clicked => { root.page = 0; } }
                Button { text: "⌕ 搜索"; primary: root.page == 1; clicked => { root.page = 1; } }
                Button { text: "▤ 题库"; primary: root.page == 2; clicked => { root.page = 2; root.refresh(); } }
                Button { text: "⚙ 设置"; primary: root.page == 3; clicked => { root.page = 3; } }
            }
        }
    }
}

import { Button, LineEdit, ComboBox, CheckBox, StandardListView, StandardTableView,
         GroupBox, TabWidget, TextEdit, ProgressIndicator, Palette } from "std-widgets.slint";

export struct FileRow { name: string, path: string }
export struct QuestionRow { id: int, title: string, options: string, kind: string, answer: string, date: string, selected: bool }

export component MainWindow inherits Window {
    title: "TikuLocal · Material Design";
    width: 920px;
    height: 560px;
    background: Palette.background;

    in-out property <int> page: 0;
    in-out property <string> query: "";
    in-out property <int> filter-index: 0;
    in-out property <int> selected-file-index: -1;
    in-out property <int> selected-manage-row: -1;
    in-out property <string> status: "准备就绪";
    in-out property <string> import-report: "暂无导入记录";
    in-out property <string> database-path: "";
    in-out property <string> service-state: "检查本地 API …";
    in-out property <bool> import-busy: false;
    in-out property <bool> confirm-clear: false;
    in-out property <bool> confirm-delete: false;
    in-out property <int> theme-mode: 0;
    in-out property <bool> system-dark: false;

    in property <[FileRow]> staged-files;
    in property <[QuestionRow]> search-results;
    in property <[QuestionRow]> manage-rows;
    in property <[StandardListViewItem]> file-items;
    in property <[[StandardListViewItem]]> search-table-rows;
    in property <[[StandardListViewItem]]> manage-table-rows;
    in property <int> match-count: 0;
    in property <int> total: 0;
    in property <int> single-count: 0;
    in property <int> multiple-count: 0;
    in property <int> blank-count: 0;
    in property <int> judge-count: 0;
    in property <int> essay-count: 0;
    in property <int> selected-count: 0;

    callback choose-files();
    callback import-all();
    callback remove-staged(int);
    callback clear-staged();
    callback search(string, int);
    callback refresh();
    callback toggle-selected(int);
    callback delete-selected();
    callback clear-all();
    callback open-folder();
    callback export-json();
    callback theme-changed(int);

    public function apply-palette(mode: int) {
        Palette.color-scheme = mode == 2 ? ColorScheme.dark
            : (mode == 1 ? ColorScheme.light : ColorScheme.unknown);
    }

    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        HorizontalLayout {
            height: 35px;
            spacing: 12px;
            Text {
                text: "TikuLocal";
                color: Palette.foreground;
                font-size: 24px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: "本地题库  ·  Material Design";
                color: Palette.foreground;
                font-size: 12px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: root.total + " 道题目";
                color: Palette.foreground;
                vertical-alignment: center;
            }
        }

        TabWidget {
            current-index <=> root.page;

            Tab {
                title: "导入题库";
                VerticalLayout {
                    spacing: 7px;
                    Text { text: "导入题目"; color: Palette.foreground; font-size: 23px; font-weight: 650; }
                    GroupBox {
                        title: "添加 Word / JSON 文件";
                        height: 122px;
                        VerticalLayout {
                            spacing: 7px;
                            Text {
                                text: "从 Word (.docx) 或 JSON 导入答案，标准答案优先，答对的个人答案也能导入。";
                                color: Palette.foreground;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                height: 36px;
                                spacing: 10px;
                                Button { text: "选择文件…"; primary: true; clicked => { root.choose-files(); } }
                                Button {
                                    text: "全部导入";
                                    enabled: root.staged-files.length > 0 && !root.import-busy;
                                    clicked => { root.import-all(); }
                                }
                                Button {
                                    text: "清空列表";
                                    enabled: root.staged-files.length > 0 && !root.import-busy;
                                    clicked => { root.clear-staged(); root.selected-file-index = -1; }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                if root.import-busy: ProgressIndicator { width: 22px; height: 22px; indeterminate: true; }
                            }
                        }
                    }
                    GroupBox {
                        title: "待导入文件 (" + root.staged-files.length + ")";
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 8px;
                            StandardListView {
                                model: root.file-items;
                                current-item <=> root.selected-file-index;
                                vertical-stretch: 1;
                            }
                            HorizontalLayout {
                                height: 36px;
                                Button {
                                    text: "移除选中的文件";
                                    enabled: root.selected-file-index >= 0 && !root.import-busy;
                                    clicked => {
                                        root.remove-staged(root.selected-file-index);
                                        root.selected-file-index = -1;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }
                    }
                    GroupBox {
                        title: "导入结果";
                        height: 98px;
                        TextEdit {
                            text: root.import-report;
                            read-only: true;
                            font-size: 12px;
                        }
                    }
                }
            }

            Tab {
                title: "搜索答案";
                VerticalLayout {
                    spacing: 9px;
                    Text { text: "搜索本地题库"; color: Palette.foreground; font-size: 23px; font-weight: 650; }
                    GroupBox {
                        title: "搜索条件";
                        height: 80px;
                        HorizontalLayout {
                            spacing: 10px;
                            LineEdit {
                                placeholder-text: "输入题目或关键词";
                                text <=> root.query;
                                horizontal-stretch: 1;
                                accepted => { root.search(root.query, root.filter-index); }
                            }
                            ComboBox {
                                width: 126px;
                                model: ["全部题型", "单选", "多选", "填空", "判断", "问答"];
                                current-index <=> root.filter-index;
                            }
                            Button {
                                text: "搜索";
                                primary: true;
                                clicked => { root.search(root.query, root.filter-index); }
                            }
                        }
                    }
                    GroupBox {
                        title: "搜索结果 · " + root.match-count + " 条";
                        vertical-stretch: 1;
                        StandardTableView {
                            columns: [
                                { title: "题型", width: 72px },
                                { title: "题目", width: 275px },
                                { title: "选项", width: 205px },
                                { title: "正确答案", width: 160px },
                            ];
                            rows: root.search-table-rows;
                        }
                    }
                }
            }

            Tab {
                title: "题库管理";
                VerticalLayout {
                    spacing: 9px;
                    Text { text: "题库管理"; color: Palette.foreground; font-size: 23px; font-weight: 650; }
                    GroupBox {
                        title: "题目概况";
                        height: 59px;
                        HorizontalLayout {
                            spacing: 16px;
                            Text { text: "全部 " + root.total; color: Palette.foreground; }
                            Text { text: "单选 " + root.single-count; color: Palette.foreground; }
                            Text { text: "多选 " + root.multiple-count; color: Palette.foreground; }
                            Text { text: "填空 " + root.blank-count; color: Palette.foreground; }
                            Text { text: "判断 " + root.judge-count; color: Palette.foreground; }
                            Text { text: "问答 " + root.essay-count; color: Palette.foreground; }
                        }
                    }
                    HorizontalLayout {
                        height: 38px;
                        spacing: 8px;
                        Button { text: "刷新"; clicked => { root.refresh(); } }
                        Button { text: "导出 JSON…"; clicked => { root.export-json(); } }
                        Button {
                            text: "标记 / 取消当前行";
                            enabled: root.selected-manage-row >= 0;
                            clicked => { root.toggle-selected(root.selected-manage-row); }
                        }
                        Button {
                            text: "删除已标记 (" + root.selected-count + ")";
                            enabled: root.selected-count > 0;
                            clicked => { root.confirm-delete = true; }
                        }
                        Button { text: "清空整个题库…"; clicked => { root.confirm-clear = true; } }
                    }
                    if root.confirm-delete: GroupBox {
                        title: "确认删除";
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "即将永久删除 " + root.selected-count + " 条已标记的题目。"; color: Palette.foreground; }
                            Button { text: "取消"; clicked => { root.confirm-delete = false; } }
                            Button {
                                text: "确认删除";
                                clicked => { root.delete-selected(); root.confirm-delete = false; }
                            }
                        }
                    }
                    if root.confirm-clear: GroupBox {
                        title: "危险操作";
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: "确认永久清空所有题目？"; color: Palette.foreground; }
                            Button { text: "取消"; clicked => { root.confirm-clear = false; } }
                            Button {
                                text: "清空全部";
                                clicked => { root.clear-all(); root.confirm-clear = false; }
                            }
                        }
                    }
                    GroupBox {
                        title: "最近题目（勾号表示已标记）";
                        vertical-stretch: 1;
                        StandardTableView {
                            columns: [
                                { title: "标记", width: 55px },
                                { title: "编号", width: 62px },
                                { title: "题型", width: 75px },
                                { title: "题目", width: 285px },
                                { title: "正确答案", width: 150px },
                            ];
                            rows: root.manage-table-rows;
                            current-row <=> root.selected-manage-row;
                        }
                    }
                }
            }

            Tab {
                title: "设置与服务";
                VerticalLayout {
                    spacing: 9px;
                    Text { text: "设置"; color: Palette.foreground; font-size: 23px; font-weight: 650; }
                    GroupBox {
                        title: "应用外观";
                        height: 79px;
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "颜色模式"; color: Palette.foreground; vertical-alignment: center; }
                            ComboBox {
                                width: 176px;
                                model: ["跟随系统", "浅色", "深色"];
                                current-index <=> root.theme-mode;
                                selected(value) => {
                                    root.apply-palette(root.theme-mode);
                                    root.theme-changed(root.theme-mode);
                                }
                            }
                            Text { text: "标准控件使用 Slint 官方 Material 样式"; color: Palette.foreground; vertical-alignment: center; }
                        }
                    }
                    GroupBox {
                        title: "本地题库接口";
                        height: 148px;
                        VerticalLayout {
                            spacing: 10px;
                            Text { text: root.service-state; color: Palette.foreground; }
                            LineEdit {
                                text: "http://127.0.0.1:8060/adapter-service/search";
                                read-only: true;
                            }
                            Text {
                                text: "仅监听本机回环地址，兼容 OCS / tikuAdapter 题库 API";
                                color: Palette.foreground;
                            }
                        }
                    }
                    GroupBox {
                        title: "数据库位置";
                        height: 117px;
                        VerticalLayout {
                            spacing: 10px;
                            LineEdit { text: root.database-path; read-only: true; }
                            HorizontalLayout {
                                Button { text: "打开目录"; clicked => { root.open-folder(); } }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }

        HorizontalLayout {
            height: 28px;
            spacing: 10px;
            Text { text: root.status; color: Palette.foreground; font-size: 12px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: "API: 127.0.0.1:8060"; color: Palette.foreground; font-size: 11px; vertical-alignment: center; }
        }
    }
}

import { Button, LineEdit, ComboBox, StandardListView, StandardTableView,
         GroupBox, TextEdit, ProgressIndicator, Palette } from "std-widgets.slint";

// Consistent Material action/control geometry. Underlying widgets stay official.
component M3Button inherits Button { height: 40px; horizontal-stretch: 0; }
component M3Field inherits LineEdit { height: 48px; }
component M3Select inherits ComboBox { height: 48px; }

export struct FileRow { name: string, path: string }
export struct QuestionRow { id: int, title: string, options: string, kind: string, answer: string, date: string, selected: bool }

component DrawerItem inherits Rectangle {
    in property <image> glyph;
    in property <string> caption;
    in property <bool> current;
    in property <bool> dark;
    callback activated();
    height: 56px;
    border-radius: 28px;
    background: current ? (dark ? #4e4161 : #e8def8)
        : (hit.has-hover ? (dark ? #302a38 : #e8e2ec) : transparent);

    // Absolute geometry keeps the icon centered irrespective of font metrics and DPI.
    Image {
        source: root.glyph;
        x: 20px; y: (root.height - 24px) / 2;
        width: 24px; height: 24px;
        image-fit: contain;
        colorize: root.current ? (dark ? #f0e6ff : #4f378b)
            : (dark ? #c4bdcc : #6f6675);
    }
    Text {
        text: root.caption;
        x: 60px; y: 0px; width: root.width - 76px; height: root.height;
        font-size: 14px; font-weight: root.current ? 700 : 500;
        vertical-alignment: center;
        color: root.current ? (dark ? #f4edff : #382a54)
            : (dark ? #e0d7e7 : #413946);
    }
    hit := TouchArea { clicked => { root.activated(); } }
}

component SummaryTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> dark;
    in property <bool> featured: false;
    height: 84px;
    horizontal-stretch: 1;
    border-radius: 20px;
    border-width: 1px;
    border-color: featured ? (dark ? #73669c : #cabfe6) : (dark ? #433f4b : #e9e3ef);
    background: featured ? (dark ? #413653 : #ebe2fa) : (dark ? #2b2832 : #ffffff);
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        Text { text: root.label; color: root.dark ? #c5bdcc : #675e71; font-size: 12px; }
        Text { text: root.value; color: root.dark ? #f4ebff : #27202c; font-size: 22px; font-weight: 700; }
    }
}

export component MainWindow inherits Window {
    title: "TikuLocal · Material 工作台";
    width: 1030px;
    height: 635px;
    background: root.canvas;

    in-out property <int> page: 0;
    in-out property <string> query: "";
    in-out property <int> filter-index: 0;
    in-out property <int> selected-file-index: -1;
    in-out property <int> selected-manage-row: -1;
    in-out property <string> status: "准备就绪";
    in-out property <string> import-report: "暂无导入记录";
    in-out property <string> database-path: "";
    in-out property <string> service-state: "检查本地 API …";
    in-out property <bool> import-busy: false;
    in-out property <bool> confirm-clear: false;
    in-out property <bool> confirm-delete: false;
    in-out property <int> theme-mode: 0;
    in-out property <bool> system-dark: false;

    in property <[FileRow]> staged-files;
    in property <[QuestionRow]> search-results;
    in property <[QuestionRow]> manage-rows;
    in property <[StandardListViewItem]> file-items;
    in property <[[StandardListViewItem]]> search-table-rows;
    in property <[[StandardListViewItem]]> manage-table-rows;
    in property <int> match-count: 0;
    in property <int> total: 0;
    in property <int> single-count: 0;
    in property <int> multiple-count: 0;
    in property <int> blank-count: 0;
    in property <int> judge-count: 0;
    in property <int> essay-count: 0;
    in property <int> selected-count: 0;

    callback choose-files();
    callback import-all();
    callback remove-staged(int);
    callback clear-staged();
    callback search(string, int);
    callback refresh();
    callback toggle-selected(int);
    callback delete-selected();
    callback clear-all();
    callback open-folder();
    callback export-json();
    callback theme-changed(int);

    public function apply-palette(mode: int) {
        Palette.color-scheme = mode == 2 ? ColorScheme.dark
            : (mode == 1 ? ColorScheme.light : ColorScheme.unknown);
    }

    private property <bool> is-dark: root.theme-mode == 2 || (root.theme-mode == 0 && root.system-dark);
    private property <brush> canvas: root.is-dark ? #1a171e : #f8f7fb;
    private property <brush> sidebar: root.is-dark ? #211e27 : #f1edf6;
    private property <brush> surface: root.is-dark ? #292630 : #ffffff;
    private property <brush> outline: root.is-dark ? #433d4c : #e9e3ed;
    private property <brush> accent: root.is-dark ? #d2baff : #6750a4;
    private property <brush> tint: root.is-dark ? #392d48 : #eee6fa;
    private property <brush> primary-text: root.is-dark ? #f2edf7 : #26202c;
    private property <brush> secondary-text: root.is-dark ? #bcb3c3 : #6b6171;

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 252px;
            background: root.sidebar;
            VerticalLayout {
                padding-left: 14px; padding-right: 14px;
                padding-top: 16px; padding-bottom: 14px;
                spacing: 8px;
                HorizontalLayout {
                    height: 70px;
                    spacing: 11px;
                    Rectangle {
                        width: 45px; height: 45px; border-radius: 14px; background: #6750a4;
                        Text { text: "T"; font-size: 25px; font-weight: 800; color: white;
                            vertical-alignment: center; horizontal-alignment: center; }
                    }
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "TikuLocal"; font-size: 19px; font-weight: 750; color: root.primary-text; }
                        Text { text: "OFFLINE QUESTION BANK"; font-size: 9px; color: root.secondary-text; }
                    }
                }
                Text { text: "工作空间"; color: root.secondary-text; font-size: 12px; font-weight: 700; height: 32px; vertical-alignment: center; }
                DrawerItem { glyph: @image-url("icons/import.svg"); caption: "导入题库"; dark: root.is-dark; current: root.page == 0; activated => { root.page = 0; } }
                DrawerItem { glyph: @image-url("icons/search.svg"); caption: "搜索答案"; dark: root.is-dark; current: root.page == 1; activated => { root.page = 1; } }
                DrawerItem { glyph: @image-url("icons/library.svg"); caption: "题库管理"; dark: root.is-dark; current: root.page == 2; activated => { root.page = 2; root.refresh(); } }
                Rectangle { height: 18px; background: transparent; }
                Rectangle { height: 1px; background: root.outline; }
                Text { text: "偏好与服务"; color: root.secondary-text; font-size: 12px; font-weight: 700; height: 32px; vertical-alignment: center; }
                DrawerItem { glyph: @image-url("icons/settings.svg"); caption: "设置与连接"; dark: root.is-dark; current: root.page == 3; activated => { root.page = 3; } }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle {
                    height: 107px; border-radius: 20px; background: root.surface;
                    border-width: 1px; border-color: root.outline;
                    VerticalLayout {
                        padding: 14px; spacing: 7px;
                        Text { text: "●  本地题库服务"; color: root.accent; font-weight: 700; font-size: 13px; }
                        Text { text: "127.0.0.1 : 8060"; color: root.primary-text; font-size: 12px; }
                        Text { text: "Rust  ·  Material Design"; color: root.secondary-text; font-size: 11px; }
                    }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: root.canvas;
            VerticalLayout {
                padding-left: 20px; padding-right: 20px;
                padding-top: 12px; padding-bottom: 12px;
                spacing: 10px;
                HorizontalLayout {
                    height: 32px; spacing: 8px;
                    Text {
                        text: "TIKULOCAL  /  " + (root.page == 0 ? "导入" : root.page == 1 ? "搜索" : root.page == 2 ? "题库" : "设置");
                        color: root.secondary-text; font-size: 11px; font-weight: 700; vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    M3Button {
                        text: root.is-dark ? "☀  浅色" : "☾  深色";
                        clicked => {
                            root.theme-mode = root.is-dark ? 1 : 2;
                            root.apply-palette(root.theme-mode);
                            root.theme-changed(root.theme-mode);
                        }
                    }
                }
                if root.page == 0: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    VerticalLayout {
                        height: 52px; spacing: 4px;
                        Text { text: "导入题库"; color: root.primary-text; font-size: 24px; font-weight: 700; }
                        Text { text: "将 Word 和 JSON 答案导入本地，支持批量处理。"; color: root.secondary-text; font-size: 12px; }
                    }
                    Rectangle {
                        height: 118px; border-radius: 24px; background: root.tint;
                        HorizontalLayout {
                            padding: 16px; spacing: 14px;
                            Rectangle {
                                width: 58px; height: 58px; border-radius: 16px;
                                background: root.is-dark ? #574470 : #ded1f2;
                                Image {
                                    source: @image-url("icons/import.svg");
                                    width: 26px; height: 26px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: root.accent;
                                }
                            }
                            VerticalLayout {
                                spacing: 7px; horizontal-stretch: 1;
                                Text { text: "导入 .docx / .json 文件"; color: root.primary-text; font-size: 16px; font-weight: 700; }
                                Text { text: "标准答案与验证正确的个人答案均可收录"; color: root.secondary-text; font-size: 11px; }
                                HorizontalLayout {
                                    spacing: 9px;
                                    M3Button { text: "选择文件…"; width: 155px; primary: true; clicked => { root.choose-files(); } }
                                    M3Button {
                                        width: 172px;
                                        text: "导入全部 (" + root.staged-files.length + ")";
                                        enabled: root.staged-files.length > 0 && !root.import-busy;
                                        clicked => { root.import-all(); }
                                    }
                                    if root.import-busy: ProgressIndicator { width: 24px; height: 24px; indeterminate: true; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1; border-radius: 20px; background: root.surface;
                        border-width: 1px; border-color: root.outline;
                        VerticalLayout {
                            padding: 12px; spacing: 7px;
                            HorizontalLayout {
                                height: 34px; spacing: 7px;
                                Text { text: "待导入文件  ·  " + root.staged-files.length; color: root.primary-text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                M3Button {
                                    text: "移除选中";
                                    enabled: root.selected-file-index >= 0 && !root.import-busy;
                                    clicked => { root.remove-staged(root.selected-file-index); root.selected-file-index = -1; }
                                }
                                M3Button { text: "清空"; enabled: root.staged-files.length > 0 && !root.import-busy;
                                    clicked => { root.clear-staged(); root.selected-file-index = -1; } }
                            }
                            StandardListView {
                                model: root.file-items;
                                current-item <=> root.selected-file-index;
                                vertical-stretch: 1;
                            }
                        }
                    }
                    Rectangle {
                        height: 104px; border-radius: 20px; background: root.surface;
                        border-width: 1px; border-color: root.outline;
                        VerticalLayout {
                            padding: 11px; spacing: 6px;
                            Text { text: "最近导入记录"; color: root.primary-text; font-size: 13px; font-weight: 700; }
                            TextEdit { text: root.import-report; read-only: true; font-size: 12px; }
                        }
                    }
                }
                if root.page == 1: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    VerticalLayout {
                        height: 52px; spacing: 4px;
                        Text { text: "搜索答案"; color: root.primary-text; font-size: 24px; font-weight: 700; }
                        Text { text: "快速检索本地题目、选项与正确答案。"; color: root.secondary-text; font-size: 12px; }
                    }
                    Rectangle {
                        height: 108px; border-radius: 20px; background: root.surface;
                        border-width: 1px; border-color: root.outline;
                        VerticalLayout {
                            padding: 14px; spacing: 9px;
                            Text { text: "搜索题库"; color: root.primary-text; font-size: 12px; font-weight: 700; }
                            HorizontalLayout {
                                spacing: 9px;
                                M3Field { text <=> root.query; placeholder-text: "输入题目、关键词…";
                                    horizontal-stretch: 1; accepted => { root.search(root.query,root.filter-index); } }
                                M3Select { width: 118px; model: ["全部题型","单选","多选","填空","判断","问答"];
                                    current-index <=> root.filter-index; }
                                M3Button { text: "搜索"; primary: true; clicked => { root.search(root.query,root.filter-index); } }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 84px; spacing: 12px;
                        SummaryTile { label: "题库题目"; value: root.total; dark: root.is-dark; }
                        SummaryTile { label: "搜索命中"; value: root.match-count; featured: true; dark: root.is-dark; }
                        SummaryTile { label: "本地模式"; value: "离线"; dark: root.is-dark; }
                    }
                    Rectangle {
                        vertical-stretch: 1; border-radius: 20px; background: root.surface;
                        border-width: 1px; border-color: root.outline;
                        VerticalLayout {
                            padding: 12px; spacing: 8px;
                            Text { text: "匹配结果  ·  " + root.match-count + " 道"; color: root.primary-text; font-size: 14px; font-weight: 700; }
                            StandardTableView {
                                columns: [
                                    { title: "题型", width: 83px },
                                    { title: "题目内容", width: 235px },
                                    { title: "选项", width: 185px },
                                    { title: "正确答案", width: 155px },
                                ];
                                rows: root.search-table-rows;
                                vertical-stretch: 1;
                            }
                        }
                    }
                }
                if root.page == 2: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    VerticalLayout {
                        height: 52px; spacing: 4px;
                        Text { text: "题库管理"; color: root.primary-text; font-size: 24px; font-weight: 700; }
                        Text { text: "整理、导出、筛选和删除已收录的题目。"; color: root.secondary-text; font-size: 12px; }
                    }
                    HorizontalLayout {
                        height: 84px; spacing: 10px;
                        SummaryTile { label: "总题目"; value: root.total; featured: true; dark: root.is-dark; }
                        SummaryTile { label: "单选"; value: root.single-count; dark: root.is-dark; }
                        SummaryTile { label: "多选"; value: root.multiple-count; dark: root.is-dark; }
                        SummaryTile { label: "填空"; value: root.blank-count; dark: root.is-dark; }
                        SummaryTile { label: "判断 / 问答"; value: (root.judge-count + root.essay-count); dark: root.is-dark; }
                    }
                    HorizontalLayout {
                        height: 44px; spacing: 8px;
                        M3Button { text: "刷新"; clicked => { root.refresh(); } }
                        M3Button { text: "导出 JSON…"; clicked => { root.export-json(); } }
                        M3Button {
                            text: "标记当前行";
                            enabled: root.selected-manage-row >= 0;
                            clicked => { root.toggle-selected(root.selected-manage-row); }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        M3Button { text: "删除已标记 (" + root.selected-count + ")"; enabled: root.selected-count > 0;
                            clicked => { root.confirm-delete = true; } }
                        M3Button { text: "清空全部…"; clicked => { root.confirm-clear = true; } }
                    }
                    if root.confirm-delete: Rectangle {
                        height: 48px; background: root.tint; border-radius: 16px;
                        HorizontalLayout { padding: 7px; spacing: 7px;
                            Text { text: "永久删除 " + root.selected-count + " 道题目？"; color: root.primary-text; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            M3Button { text: "取消"; clicked => { root.confirm-delete = false; } }
                            M3Button { text: "确认删除"; clicked => { root.delete-selected(); root.confirm-delete = false; } }
                        }
                    }
                    if root.confirm-clear: Rectangle {
                        height: 48px; background: root.tint; border-radius: 16px;
                        HorizontalLayout { padding: 7px; spacing: 7px;
                            Text { text: "永久清空所有题目？"; color: root.primary-text; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            M3Button { text: "取消"; clicked => { root.confirm-clear = false; } }
                            M3Button { text: "确认清空"; clicked => { root.clear-all(); root.confirm-clear = false; } }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1; border-radius: 20px; background: root.surface;
                        border-width: 1px; border-color: root.outline;
                        VerticalLayout {
                            padding: 12px; spacing: 8px;
                            Text { text: "最近题目  ·  选择行后可标记删除"; color: root.primary-text; font-size: 14px; font-weight: 700; }
                            StandardTableView {
                                columns: [
                                    { title: "标记", width: 78px },
                                    { title: "编号", width: 55px },
                                    { title: "题型", width: 86px },
                                    { title: "题目", width: 230px },
                                    { title: "正确答案", width: 160px },
                                ];
                                rows: root.manage-table-rows;
                                current-row <=> root.selected-manage-row;
                                vertical-stretch: 1;
                            }
                        }
                    }
                }
                if root.page == 3: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 12px;
                    VerticalLayout {
                        height: 52px; spacing: 4px;
                        Text { text: "设置与连接"; color: root.primary-text; font-size: 24px; font-weight: 700; }
                        Text { text: "管理主题、题库存储和本地接口。"; color: root.secondary-text; font-size: 13px; }
                    }
                    Rectangle {
                        height: 104px; border-radius: 20px; background: root.surface;
                        border-width: 1px; border-color: root.outline;
                        VerticalLayout {
                            padding: 14px; spacing: 6px;
                            Text { text: "外观偏好"; color: root.primary-text; font-weight: 700; font-size: 14px; }
                            HorizontalLayout {
                                spacing: 12px;
                                Text { text: "主题模式"; color: root.secondary-text; font-size: 13px; vertical-alignment: center; }
                                M3Select {
                                    model: ["跟随系统","浅色","深色"]; width: 175px;
                                    current-index <=> root.theme-mode;
                                    selected(value) => { root.apply-palette(root.theme-mode); root.theme-changed(root.theme-mode); }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                Text { text: "Material 主题"; color: root.secondary-text; font-size: 12px; vertical-alignment: center; }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 172px; spacing: 12px;
                        Rectangle {
                            horizontal-stretch: 1; border-radius: 20px; background: root.surface;
                            border-width: 1px; border-color: root.outline;
                            VerticalLayout {
                                padding: 14px; spacing: 10px;
                                Text { text: "本地题库 API"; color: root.primary-text; font-size: 14px; font-weight: 700; }
                                Text { text: root.service-state; color: root.accent; font-size: 13px; }
                                M3Field { text: "http://127.0.0.1:8060/adapter-service/search"; read-only: true; }
                                Text { text: "回环地址，仅本机可访问"; color: root.secondary-text; font-size: 12px; }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1; border-radius: 20px; background: root.surface;
                            border-width: 1px; border-color: root.outline;
                            VerticalLayout {
                                padding: 14px; spacing: 10px;
                                Text { text: "数据库位置"; color: root.primary-text; font-size: 14px; font-weight: 700; }
                                M3Field { text: root.database-path; read-only: true; }
                                M3Button { text: "打开数据目录"; clicked => { root.open-folder(); } }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1; border-radius: 20px;
                        background: root.tint;
                        HorizontalLayout {
                            padding: 14px; spacing: 14px;
                            Rectangle {
                                width: 46px; height: 46px; border-radius: 16px;
                                background: root.is-dark ? #5d4a75 : #d6c6ec;
                                Image {
                                    source: @image-url("icons/library.svg");
                                    width: 24px; height: 24px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    colorize: root.is-dark ? #f0e6ff : #514072;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "备份与隐私"; font-size: 14px; font-weight: 700; color: root.primary-text; }
                                Text { text: "题目只保存在本机，支持导出 JSON 备份。"; font-size: 12px; color: root.secondary-text; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            M3Button { text: "导出题库"; primary: true; clicked => { root.export-json(); } }
                        }
                    }
                }
                Rectangle {
                    height: 28px; background: transparent;
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { width: 7px; height: 7px; border-radius: 4px; background: #32a377; }
                        Text { text: root.status; color: root.secondary-text; font-size: 11px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text { text: "LOCAL API  :  8060"; color: root.secondary-text; font-size: 10px; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}

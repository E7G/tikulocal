
import { Button, LineEdit, ComboBox, CheckBox, ListView, ScrollView, ProgressIndicator, TextEdit } from "std-widgets.slint";

export struct FileRow { name: string, path: string }
export struct QuestionRow { id: int, title: string, options: string, kind: string, answer: string, date: string, selected: bool }

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback activated();
    height: 45px;
    border-radius: 9px;
    background: selected ? #daeafb : (hit.has-hover ? #e9f0f8 : transparent);
    Rectangle { x: 0px; width: 4px; height: 25px; y: 10px; border-radius: 2px; background: selected ? #1675d1 : transparent; }
    Text {
        text: root.label;
        x: 17px; y: 0px; width: parent.width - 25px; height: parent.height;
        vertical-alignment: center;
        font-size: 14px; font-weight: selected ? 700 : 400;
        color: selected ? #005aab : #33445d;
    }
    hit := TouchArea { clicked => { root.activated(); } }
}

component MetricCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    height: 100px;
    horizontal-stretch: 1;
    background: white; border-radius: 12px; border-width: 1px; border-color: #e4e9ef;
    drop-shadow-blur: 9px; drop-shadow-color: #0a234560; drop-shadow-offset-y: 2px;
    VerticalLayout {
        padding: 16px; spacing: 8px;
        Text { text: root.title; color: #627086; font-size: 13px; }
        Text { text: root.value; color: #12243e; font-size: 29px; font-weight: 700; }
    }
}

export component MainWindow inherits Window {
    title: "TikuLocal · 题库工作台";
    width: 1100px; height: 760px;

    background: #f5f7fb;
    default-font-family: "Microsoft YaHei UI";

    in-out property <int> page: 0;
    in-out property <string> query: "";
    in-out property <int> filter-index: 0;
    in-out property <string> status: "准备就绪。";
    in-out property <string> import-report: "还没有导入记录";
    in-out property <string> database-path: "";
    in-out property <string> service-state: "本地 API 已启用";
    in-out property <bool> import-busy: false;
    in-out property <bool> confirm-clear: false;
    in-out property <bool> confirm-delete: false;
    in property <[FileRow]> staged-files;
    in property <[QuestionRow]> search-results;
    in property <[QuestionRow]> manage-rows;
    in property <int> match-count: 0;
    in property <int> total: 0;
    in property <int> single-count: 0;
    in property <int> multiple-count: 0;
    in property <int> blank-count: 0;
    in property <int> judge-count: 0;
    in property <int> essay-count: 0;
    in property <int> selected-count: 0;

    callback choose-files();
    callback import-all();
    callback remove-staged(int);
    callback clear-staged();
    callback search(string, int);
    callback refresh();
    callback toggle-selected(int);
    callback delete-selected();
    callback clear-all();
    callback open-folder();
    callback export-json();

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 228px; background: #edf2f8;
            border-color: #dbe3ee; border-width: 1px;
            VerticalLayout {
                padding-left: 18px; padding-right: 18px; padding-top: 28px; padding-bottom: 18px; spacing: 7px;
                Rectangle {
                    height: 80px; background: transparent;
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: "TIKU LOCAL"; font-weight: 800; font-size: 24px; color: #1469ba; }
                        Text { text: "轻量化本地题库工作台"; font-size: 12px; color: #79879a; }
                    }
                }
                Text { text: "工作区"; font-size: 11px; color: #8290a3; font-weight: 700; }
                NavItem { label: "  ⤓   批量导入"; selected: root.page == 0; activated => { root.page = 0; } }
                NavItem { label: "  ⌕   搜索答案"; selected: root.page == 1; activated => { root.page = 1; } }
                NavItem { label: "  ▤   题库管理"; selected: root.page == 2; activated => { root.page = 2; root.refresh(); } }
                NavItem { label: "  ⚙   设置与服务"; selected: root.page == 3; activated => { root.page = 3; } }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle {
                    height: 86px; background: #e1eaf4; border-radius: 10px;
                    VerticalLayout { padding: 12px; spacing: 7px;
                        Text { text: "本地服务 · 8060"; font-size: 13px; color: #1364af; font-weight: 700; }
                        Text { text: root.service-state; font-size: 11px; color: #586a80; }
                        Text { text: "Rust + Fluent UI"; font-size: 11px; color: #7a8aa0; }
                    }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1; background: #f5f7fb;
            VerticalLayout {
                padding: 29px; spacing: 18px;
                if root.page == 0: VerticalLayout {
                    spacing: 16px;
                    Text { text: "导入题库"; font-size: 29px; font-weight: 700; color: #152740; }
                    Text { text: "批量添加 Word 或 JSON 文件，检查列表后统一导入。"; color: #718197; font-size: 14px; }
                    Rectangle {
                        height: 92px; background: white; border-radius: 13px; border-width: 1px; border-color: #e0e7ef;
                        HorizontalLayout { padding: 18px; spacing: 12px;
                            VerticalLayout { horizontal-stretch: 1; spacing: 7px;
                                Text { text: "导入文件"; font-size: 15px; font-weight: 700; color: #24364e; }
                                Text { text: "支持 .docx / .json，多文件导入，识别标准答案及批改正确的个人答案"; font-size: 12px; color: #7b899b; }
                            }
                            Button { text: "＋ 选择文件"; clicked => { root.choose-files(); } }
                        }
                    }
                    HorizontalLayout { spacing: 12px;
                        Text { text: "待导入文件"; font-size: 18px; font-weight: 700; color: #26384f; vertical-alignment: center; }
                        Text { text: root.staged-files.length + " 个文件"; color: #748299; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button { text: "清空列表"; enabled: root.staged-files.length > 0 && !root.import-busy; clicked => { root.clear-staged(); } }
                        Button { text: root.import-busy ? "正在导入…" : "导入全部"; enabled: root.staged-files.length > 0 && !root.import-busy; primary: true; clicked => { root.import-all(); } }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        background: white; border-radius: 13px; border-width: 1px; border-color: #e2e8f1;
                        ListView {
                            for file[i] in root.staged-files : Rectangle {
                                height: 55px; background: Math.mod(i, 2) == 0 ? white : #fafbfd;
                                HorizontalLayout { padding-left: 16px; padding-right: 16px; spacing: 12px;
                                    Text { text: "▣"; color: #277bc1; font-size: 20px; vertical-alignment: center; }
                                    VerticalLayout { horizontal-stretch: 1; spacing: 3px;
                                        Text { text: file.name; color: #273a53; font-weight: 600; overflow: elide; }
                                        Text { text: file.path; color: #8796aa; font-size: 11px; overflow: elide; }
                                    }
                                    Button { text: "移除"; enabled: !root.import-busy; clicked => { root.remove-staged(i); } }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 120px; background: white; border-radius: 13px; border-width: 1px; border-color: #e2e8f1;
                        VerticalLayout {
                            padding: 12px; spacing: 6px;
                            Text { text: "导入结果"; font-size: 13px; font-weight: 700; color: #29415d; }
                            TextEdit { text: root.import-report; read-only: true; font-size: 12px; }
                        }
                    }
                }
                if root.page == 1: VerticalLayout {
                    spacing: 17px;
                    Text { text: "搜索答案"; font-size: 29px; font-weight: 700; color: #152740; }
                    Text { text: "关键词智能匹配 · 忽略空格及常见标点"; color: #718197; font-size: 14px; }
                    Rectangle {
                        height: 85px; background: white; border-radius: 13px; border-width: 1px; border-color: #e2e8f1;
                        HorizontalLayout { padding: 14px; spacing: 12px;
                            LineEdit { horizontal-stretch: 1; placeholder-text: "输入题目关键词…"; text <=> root.query; accepted => { root.search(root.query, root.filter-index); } }
                            ComboBox { width: 115px; model: ["全部", "单选", "多选", "填空", "判断", "问答"]; current-index <=> root.filter-index; }
                            Button { text: "搜索"; primary: true; clicked => { root.search(root.query, root.filter-index); } }
                        }
                    }
                    Text { text: "找到 " + root.match-count + " 道匹配题目"; font-weight: 700; color: #293b53; }
                    Rectangle { vertical-stretch: 1; background: white; border-radius: 13px; border-width: 1px; border-color: #e2e8f1;
                        ListView {
                            for item[i] in root.search-results : Rectangle {
                                height: 112px; background: Math.mod(i, 2) == 0 ? white : #fafbfd;
                                VerticalLayout { padding: 15px; spacing: 7px;
                                    Text { text: item.title; font-size: 15px; font-weight: 650; color: #25384f; overflow: elide; }
                                    Text { text: item.options; color: #7c8ba1; font-size: 12px; overflow: elide; }
                                    HorizontalLayout { spacing: 15px;
                                        Text { text: item.kind; color: #6080a6; font-size: 12px; }
                                        Text { text: "正确答案：" + item.answer; color: #127653; font-size: 13px; font-weight: 700; }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.page == 2: VerticalLayout {
                    spacing: 16px;
                    Text { text: "题库管理"; font-size: 29px; font-weight: 700; color: #152740; }
                    HorizontalLayout { spacing: 12px;
                        MetricCard { title: "总题数"; value: root.total; }
                        MetricCard { title: "单选题"; value: root.single-count; }
                        MetricCard { title: "多选题"; value: root.multiple-count; }
                        MetricCard { title: "判断题"; value: root.judge-count; }
                    }
                    HorizontalLayout { spacing: 10px;
                        Text { text: "最近导入"; font-size: 18px; font-weight: 700; color: #26384f; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Button { text: "刷新"; clicked => { root.refresh(); } }
                        Button { text: "导出 JSON"; clicked => { root.export-json(); } }
                        Button { text: "删除选中 (" + root.selected-count + ")"; enabled: root.selected-count > 0; clicked => { root.confirm-delete = true; } }
                        Button { text: "清空题库"; clicked => { root.confirm-clear = true; } }
                    }
                    if root.confirm-delete: Rectangle {
                        height: 60px; background: #fff4df; border-radius: 10px;
                        HorizontalLayout { padding: 12px; spacing: 10px;
                            Text { text: "确定永久删除选中的 " + root.selected-count + " 道题目？"; color: #7f4d12; horizontal-stretch: 1; vertical-alignment: center; }
                            Button { text: "取消"; clicked => { root.confirm-delete = false; } }
                            Button { text: "确认删除"; clicked => { root.delete-selected(); root.confirm-delete = false; } }
                        }
                    }
                    if root.confirm-clear: Rectangle {
                        height: 60px; background: #fff0f1; border-radius: 10px;
                        HorizontalLayout { padding: 12px; spacing: 10px;
                            Text { text: "此操作不可恢复，确认清空全部题目？"; color: #9c2839; horizontal-stretch: 1; vertical-alignment: center; }
                            Button { text: "取消"; clicked => { root.confirm-clear = false; } }
                            Button { text: "确认清空"; clicked => { root.clear-all(); root.confirm-clear = false; } }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: white; border-radius: 13px; border-width: 1px; border-color: #e2e8f1;
                        ListView {
                            for item[i] in root.manage-rows : Rectangle {
                                height: 72px; background: item.selected ? #eaf4ff : (Math.mod(i, 2) == 0 ? white : #fafbfd);
                                HorizontalLayout { padding-left: 16px; padding-right: 14px; spacing: 14px;
                                    CheckBox { checked: item.selected; toggled => { root.toggle-selected(i); } }
                                    VerticalLayout { horizontal-stretch: 1; spacing: 6px;
                                        Text { text: item.title; color: #26384f; font-size: 14px; font-weight: 700; overflow: elide; }
                                        Text { text: item.kind + "  ·  " + item.options; color: #8190a2; font-size: 11px; overflow: elide; }
                                    }
                                    Text { text: item.answer; color: #167855; vertical-alignment: center; font-weight: 700; width: 130px; overflow: elide; }
                                }
                            }
                        }
                    }
                }
                if root.page == 3: VerticalLayout {
                    spacing: 17px;
                    Text { text: "设置与服务"; font-size: 29px; font-weight: 700; color: #152740; }
                    Rectangle {
                        height: 205px; background: white; border-radius: 13px; border-width: 1px; border-color: #e2e8f1;
                        VerticalLayout { padding: 22px; spacing: 16px;
                            Text { text: "本地 API 服务"; font-size: 18px; font-weight: 700; color: #25384f; }
                            Text { text: root.service-state; color: #147252; }
                            Text { text: "地址：http://127.0.0.1:8060/adapter-service/search"; color: #54677d; }
                            Text { text: "兼容 OCS / tikuAdapter 的题库检索响应格式"; color: #8190a3; font-size: 13px; }
                            Text { text: "仅监听本机回环地址，不会向公网开放。"; color: #8190a3; font-size: 12px; }
                        }
                    }
                    Rectangle {
                        height: 150px; background: white; border-radius: 13px; border-width: 1px; border-color: #e2e8f1;
                        VerticalLayout { padding: 22px; spacing: 14px;
                            Text { text: "数据库"; font-size: 18px; font-weight: 700; color: #25384f; }
                            Text { text: root.database-path; color: #6d7f96; overflow: elide; }
                            Button { text: "打开数据库目录"; clicked => { root.open-folder(); } }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
                Rectangle {
                    height: 49px; background: #e9eff7; border-radius: 10px;
                    HorizontalLayout { padding-left: 16px; padding-right: 16px;
                        Text { text: root.status; color: #567087; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                        if root.import-busy: ProgressIndicator { width: 23px; height: 23px; indeterminate: true; }
                    }
                }
            }
        }
    }
}
